     9                                  ; --- defines end --- ;
    10                                  ehdr:
    11 00000000 7F454C46                    db 0x7F, "ELF"
    12 00000004 02                          db 2
    13 00000005 01                          db 1
    14 00000006 01                          db 1
    15 00000007 00                          db 0
    16 00000008 0000000000000000            dq 0
    17 00000010 0200                        dw 2
    18 00000012 3E00                        dw 0x3E
    19 00000014 01000000                    dd 1
    20 00000018 [A100000000000000]          dq main
    21 00000020 4000000000000000            dq phdr - ehdr
    22 00000028 0000000000000000            dq 0
    23 00000030 00000000                    dd 0
    24 00000034 4000                        dw ehdrsize
    25 00000036 3800                        dw phdrsize
    26 00000038 0100                        dw 1
    27 0000003A 0000                        dw 0
    28 0000003C 0000                        dw 0
    29 0000003E 0000                        dw 0
    30                                  ehdrsize equ $ - ehdr
    31                                  
    32                                  phdr:
