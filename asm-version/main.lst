   321 000002DB 7530                        jnz jmp_default
   322                                      ;return
   323 000002DD EB4C                        jmp jmp_
   324                                  jmp_s:
   325 000002DF 41F6C180                    test r9b,0b10000000
   326 000002E3 7428                        jz jmp_default
   327                                      ;return
   328 000002E5 EB44                        jmp jmp_
   329                                  jmp_ns:
   330 000002E7 41F6C180                    test r9b,0b10000000
   331 000002EB 7520                        jnz jmp_default
   332                                      ;return
   333 000002ED EB3C                        jmp jmp_
   334                                  ins_jmpm:
   335 000002EF 410FBAF804                  btc r8d,4 ; test if counter enough
   336 000002F4 0F8373FEFFFF                jnc push_in ; counter not enough
   337 000002FA 8D4304                      lea eax, [rbx+4]
   338 000002FD 83E007                      and eax, 7
   339 00000300 418B0484                    mov eax, [r12+rax*4] ; at(4)
   340 00000304 8B0485[8A030000]            mov eax, [rax*4+jmpm_table]
