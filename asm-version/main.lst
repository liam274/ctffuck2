   307 000002B1 0F83B6FEFFFF                jnc push_in
   308 000002B7 8D4B01                      lea ecx, [rbx+1]
   309 000002BA 83E107                      and ecx, 7
   310 000002BD 418B0C8C                    mov ecx, [r12+rcx*4] ; at(1)
   311 000002C1 01448D00                    add [rbp+rcx*4], eax
   312 000002C5 E8AFFFFFFF                  call setf
   313 000002CA E971FEFFFF                  jmp next
   314                                  jmp_z:
