   168 00000142 49FFC5                      inc r13
   169 00000145 0F843DFFFFFF                jz exit
   170                                  loop: ; simply fall through, so as to improve performance
   171 0000014B 430FB60C2E                  movzx ecx, byte [r14+r13] ; get char
   172                                      ; digit filter
   173 00000150 8D41D0                      lea eax, [rcx-'0'] ; Instead of keep relying on ALU, here we used AGU instead
   174                                      ; So It can be synced
