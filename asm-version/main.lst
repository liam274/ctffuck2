    43                                  exit_no_arg:
    44 00000078 6A01                        push 1
    45 0000007A EB1F                        jmp no_recovery
    46                                  exit_fail_open:
    47 0000007C 6A02                        push 2
    48 0000007E EB1B                        jmp no_recovery
    49                                  exit_fail_store:
    50 00000080 6A03                        push 3
    51 00000082 EB17                        jmp no_recovery
    52                                  exit_fail_lseek:
    53 00000084 6A04                        push 4
    54 00000086 EB13                        jmp no_recovery
    55                                  exit:
    56                                      ; recover to normal mode
    57 00000088 6A10                        push 16
    58 0000008A 58                          pop rax
    59 0000008B 31FF                        xor edi,edi
    60 0000008D BE02540000                  mov esi, 0x5402
    61 00000092 BA[B2030000]                mov edx, old_termios
    62 00000097 0F05                        syscall
    63 00000099 6A00                        push 0
    64                                  no_recovery:
    65                                      ; exit
    66 0000009B 5F                          pop rdi
    67 0000009C 6A3C                        push 60 ; sys_exit
    68 0000009E 58                          pop rax
    69 0000009F 0F05                        syscall
    70                                  
    71                                  main:
    72 000000A1 59                          pop rcx ; argc
    73 000000A2 FFC9                        dec ecx
    74 000000A4 74D2                        jz exit_no_arg
    75 000000A6 5F                          pop rdi ; argv[0]
    76 000000A7 5F                          pop rdi ; argv[1]
    77                                      ; read file
    78 000000A8 31F6                        xor esi,esi
    79 000000AA 6A02                        push 2
    80 000000AC 58                          pop rax
    81 000000AD 99                          cdq ; empty edx
    82 000000AE 0F05                        syscall
    83 000000B0 4885C0                      test rax,rax ; test if success
    84 000000B3 78C7                        js exit_fail_open
    85 000000B5 97                          xchg eax, edi ; edi=fd
    86                                  
    87                                      ; get file length
    88 000000B6 6A08                        push 8
    89 000000B8 58                          pop rax
    90 000000B9 31F6                        xor esi,esi
    91 000000BB 6A02                        push 2
    92 000000BD 5A                          pop rdx ; emptied rdx high bit 32
    93 000000BE 0F05                        syscall
    94 000000C0 4885C0                      test rax,rax
    95 000000C3 74BF                        je exit_fail_lseek
    96 000000C5 50                          push rax
    97                                      ; store size in r13
    98                                  
    99                                      ; store it somewhere(mmap)
   100 000000C6 57                          push rdi
   101 000000C7 4158                        pop r8
   102 000000C9 31FF                        xor edi,edi
   103 000000CB 5E                          pop rsi
   104 000000CC 4989F5                      mov r13,rsi
   105 000000CF B201                        mov dl,1
   106 000000D1 6A02                        push 2
   107 000000D3 415A                        pop r10
   108 000000D5 4531C9                      xor r9d,r9d
   109 000000D8 6A09                        push 9
   110 000000DA 58                          pop rax
   111 000000DB 0F05                        syscall
   112 000000DD 4885C0                      test rax,rax
   113 000000E0 789E                        js exit_fail_store
   114 000000E2 4150                        push r8
   115 000000E4 5F                          pop rdi ; recover registries
   116 000000E5 4996                        xchg rax,r14 ; base addr
   117                                      ; close the file since we no longer need it
   118 000000E7 6A03                        push 3
   119 000000E9 58                          pop rax
   120 000000EA 0F05                        syscall ; file closed
   121                                  
   122                                      ; --- set raw mode --- ;
   123                                      ; since all the reg edited is not important, so it's fine to not to push them
   124 000000EC B010                        mov al, 16
   125 000000EE 31FF                        xor edi, edi
   126 000000F0 BE01540000                  mov esi, 0x5401
   127 000000F5 BA[B2030000]                mov edx, old_termios
   128 000000FA 0F05                        syscall
   129                                  
   130 000000FC 89D6                        mov esi, edx
   131 000000FE BF[EE030000]                mov edi, new_termios
   132 00000103 6A3C                        push 60
   133 00000105 59                          pop rcx
   134 00000106 F3A4                        rep movsb
   135                                  
   136 00000108 8367D0F5                    and dword [rdi + 12-60], ~(2 | 8)
   137 0000010C 66C747D90001                mov word [rdi + 21-60], 0x0100
   138                                      
   139 00000112 6A10                        push 16
   140 00000114 58                          pop rax
   141 00000115 678D57C4                    lea edx, [edi-60]
   142 00000119 BE02540000                  mov esi, 0x5402
   143 0000011E 31FF                        xor edi, edi
   144 00000120 0F05                        syscall
   145                                  
   146                                      ; init
   147 00000122 4D01EE                      add r14,r13
   148 00000125 49F7DD                      neg r13
   149 00000128 4531FF                      xor r15d,r15d ; last
   150                                      ; ecx arg
   151 0000012B 31DB                        xor ebx,ebx ; head_pointer
   152 0000012D 4531C0                      xor r8d,r8d ; counter
   153                                      ; 0 = read_counter
   154                                      ; 1 = add_counter
   155                                      ; 2 = swap counter
   156                                      ; 3 = grow counter
   157                                      ; 4 = jmpm counter
   158 00000130 41B118                      mov r9b, 0b00011000 ; flag
   159                                      ; 1 = sf
   160                                      ; 0 = zf
   161                                      ; 2 = cf
   162                                      ; 3 = if
   163                                      ; 4 = of
   164 00000133 BD[2A040000]                mov ebp,memory
   165 00000138 41BC[52040000]              mov r12d,stack
   166 0000013E EB09                        jmp loop
   167                                  next:
   168 00000140 49FFC5                      inc r13
   169 00000143 0F843FFFFFFF                jz exit
   170                                  loop: ; simply fall through, so as to improve performance
   171 00000149 430FB60C2E                  movzx ecx, byte [r14+r13] ; get char
   172                                      ; digit filter
   173 0000014E 8D41D0                      lea eax, [rcx-'0'] ; Instead of keep relying on ALU, here we used AGU instead
   174                                      ; So It can be synced
   175 00000151 3C09                        cmp al,9
   176 00000153 77EB                        ja next
   177                                  loop_exe:
   178                                      ; calc arg
   179 00000155 4429F9                      sub ecx,r15d
   180 00000158 4101CF                      add r15d, ecx
   181 0000015B 89C8                        mov eax,ecx
   182 0000015D F7D9                        neg ecx
   183 0000015F 0F48C8                      cmovs ecx,eax
   184 00000162 468B14BD[7A020000]          mov r10d, [r15*4+jump_table]
   185 0000016A 41FFE2                      jmp r10
   186                                      ;loop end
   187                                  push_in:
   188 0000016D FFC3                        inc ebx
   189 0000016F 83E307                      and ebx,7 ; assume that rcx is the arg, already
   190 00000172 41890C9C                    mov [r12+rbx*4],ecx ; write abs
   191 00000176 EBC8                        jmp next
   192                                  ins_set:
   193 00000178 31C0                        xor eax,eax
   194 0000017A 89448D00                    mov [rbp+rcx*4],eax
   195 0000017E 4180C940                    or r9b,0b01000000 ; these two command cannot be run at the same time QmQ
   196 00000182 4180E17F                    and r9b,0b01111111
   197 00000186 EBB8                        jmp next
   198                                  ins_push:
   199 00000188 EBE3                        jmp push_in
   200                                  ins_print:
   201 0000018A 41F6C108                    test r9b,0b00001000 ; check OF
   202 0000018E 74B0                        jz next
   203 00000190 837C8D0000                  cmp BOX_SIZE [rbp+rcx*4], 0 ; check if is zero
   204 00000195 74A9                        jz next ; skip so as not to print null
   205 00000197 B801000000                  mov eax, 1 ; write()
   206 0000019C 89C7                        mov edi,eax
   207 0000019E 89C2                        mov edx,eax
   208 000001A0 8D748D00                    lea esi, [rbp+rcx*4] ; pointer to addr
   209 000001A4 0F05                        syscall
   210 000001A6 EB98                        jmp next
   211                                  ins_swap:
   212 000001A8 410FBAF806                  btc r8d,6 ; check if counter enough
   213 000001AD 73BE                        jnc push_in
   214 000001AF 8D4302                      lea eax, [rbx+2]
   215 000001B2 83E007                      and eax,7
   216 000001B5 418B0484                    mov eax,[r12+rax*4] ; at(2)
   217 000001B9 448B548500                  mov r10d, [rbp+rax*4]
   218 000001BE 448B5C8D00                  mov r11d, [rbp+rcx*4]
   219 000001C3 44895C8500                  mov [rbp+rax*4], r11d
   220 000001C8 4489548D00                  mov [rbp+rcx*4], r10d
   221 000001CD E96EFFFFFF                  jmp next
   222                                  ins_grow:
   223 000001D2 410FBAF805                  btc r8d,5 ; check if counter enough
   224 000001D7 7394                        jnc push_in
   225 000001D9 8D4303                      lea eax, [rbx+3]
   226 000001DC 83E007                      and eax, 7
   227 000001DF 418B0484                    mov eax, [r12+rax*4] ; at(3)
   228 000001E3 8B0485[62030000]            mov eax, [rax*4+grow_table]
   229 000001EA FFD0                        call rax
   230 000001EC E964FFFFFF                  jmp loop_exe
   231                                  ins_inp:
   232 000001F1 41F6C110                    test r9b,0b00010000 ; test IF
   233 000001F5 0F8445FFFFFF                jz next ; if not set, bye bye
   234                                      ; getch start
   235 000001FB 31C0                        xor eax, eax
   236 000001FD 31FF                        xor edi, edi
   237 000001FF 8D748D00                    lea esi, [rbp+rcx*4]
   238 00000203 BA01000000                  mov edx, 1
   239 00000208 51                          push rcx
   240 00000209 0F05                        syscall
   241 0000020B 59                          pop rcx ; getch end
   242 0000020C 81648D00FF000000            and dword [rbp+rcx*4], 0xFF
   243 00000214 E927FFFFFF                  jmp next ; return
   244                                  ins_revf:
   245 00000219 B080                        mov al, 0x80
   246 0000021B D2E8                        shr al, cl
   247 0000021D 4130C1                      xor r9b, al
   248 00000220 E91BFFFFFF                  jmp next
   249                                  mod_grow:
   250 00000225 448B5C8D00                  mov r11d,[rbp+rcx*4]
   251 0000022A 4183FB01                    cmp r11d,1
   252 0000022E 4183D300                    adc r11d,0
   253 00000232 31D2                        xor edx,edx
   254 00000234 41F7F3                      div r11d
   255 00000237 89D1                        mov ecx,edx
   256                                      ; return
   257 00000239 EB3E                        jmp setf
   258                                  add_grow:
   259 0000023B 03448D00                    add eax,[rbp+rcx*4]
   260 0000023F EB0D                        jmp do_mod
   261                                  sub_grow:
   262 00000241 2B448D00                    sub eax,[rbp+rcx*4]
   263 00000245 EB07                        jmp do_mod
   264                                  mul_grow:
   265 00000247 0FAF448D00                  imul eax,[rbp+rcx*4]
   266 0000024C EB00                        jmp do_mod
   267                                  do_mod:
   268 0000024E 31D2                        xor edx,edx
   269 00000250 B10A                        mov cl,10
   270 00000252 F7F1                        div ecx
   271 00000254 89D1                        mov ecx,edx ; ecx = rax % 10
   272                                      ; return
   273 00000256 85C9                        test ecx,ecx
   274 00000258 EB1F                        jmp setf ; so now the stack has the return addr on top
   275                                  div_grow:
   276 0000025A 8B448D00                    mov eax,[rbp+rcx*4]
   277 0000025E EBEE                        jmp do_mod
   278                                  xchg_grow:
   279 00000260 448D0593010000              lea r8d, [jump_table+384]
   280 00000267 458B1480                    mov r10d, [r8+rax*4]
   281 0000026B 458B1C88                    mov r11d, [r8+rcx*4]
   282 0000026F 45891C80                    mov [r8+rax*4], r11d
   283 00000273 45891488                    mov [r8+rcx*4], r10d
   284                                      ; return
   285 00000277 C3                          ret
   286                                  default_grow:
   287                                      ; return
   288 00000278 C3                          ret
   289                                  setf:
   290 00000279 9F                          lahf
   291 0000027A 88E0                        mov al, ah
   292 0000027C 4180E13F                    and r9b,0b00111111
   293 00000280 24C0                        and al, 0b11000000
   294 00000282 4108C1                      or r9b, al
   295 00000285 C3                          ret
   296                                  ins_read:
   297 00000286 410FBAF808                  btc r8d, 8 ; if counter ok
   298 0000028B 0F83DCFEFFFF                jnc push_in ; only one parm
   299 00000291 418B049C                    mov eax, [r12+rbx*4] ; at(0)
   300 00000295 448B5C8D00                  mov r11d, [rbp+rcx*4]
   301 0000029A 44895C8500                  mov [rbp+rax*4], r11d
   302 0000029F 4585DB                      test r11d,r11d
   303 000002A2 E8D2FFFFFF                  call setf
   304 000002A7 E994FEFFFF                  jmp next
