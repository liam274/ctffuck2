     1                                  ; Since I'm writing asm first time, so I got help from deepseek and gemini...
     2                                  BITS 64
     3                                  org 0x400000
     4                                  default rel
     5                                  ; --- defines start --- ;
     6                                  
     7                                  %define BOX_SIZE dword
